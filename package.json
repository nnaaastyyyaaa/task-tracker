{
  "name": "task-tracker",
  "version": "1.0.0",
  "description": "Application for handling your tasks",
  "keywords": [],
  "homepage": "https://github.com/nnaaastyyyaaa/task-tracker#readme",
  "bugs": {
    "url": "https://github.com/nnaaastyyyaaa/task-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnaaastyyyaaa/task-tracker.git"
  },
  "license": "MIT",
  "author": "Anastasiia Andriienko",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node ./src/server.js",
    "build": "node --check ./src/server.js",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:test:up": "docker compose up -d db_test --wait",
    "db:test:down": "docker compose db_test down",
    "postinstall": "prisma generate",
    "app:start": "npm install && npm run db:up && npm run db:migrate && npm run check && npm start",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "18.0.7",
    "fastify": "^5.12.5",
    "pg": "8.23.1",
    "vitest": "^5.0.2"
  }
}
